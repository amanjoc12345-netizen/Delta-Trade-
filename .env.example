# Delta Trade Platform - Environment Variables
# Industrial best practice: Keys are loaded from environment, never prompted in the UI

# Optional Market API Key (Public Binance endpoints do not require a key)
VITE_MARKET_API_KEY=

# Base REST API Endpoint
VITE_BINANCE_REST_URL=https://api.binance.com

# Base WebSocket Stream Endpoint
VITE_BINANCE_WS_URL=wss://stream.binance.com:9443
